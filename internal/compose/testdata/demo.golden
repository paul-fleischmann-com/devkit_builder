# Devkit demo: Demo kit
# Generated by devkit compose; do not edit. Build context: the root of the devkits repository.
FROM docker.io/library/debian@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
ENV DEBIAN_FRONTEND=noninteractive
RUN rm -f /etc/apt/sources.list /etc/apt/sources.list.d/* \
    && printf 'Types: deb\nURIs: http://snapshot.debian.org/archive/debian/%s/\nSuites: trixie\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.pgp\nCheck-Valid-Until: no\n' '20261019T000000Z' > /etc/apt/sources.list.d/snapshot.sources
COPY features/git/ /tmp/devkit/git/
RUN cd /tmp/devkit/git && bash ./install.sh \
    && rm -rf /tmp/devkit/git /var/lib/apt/lists/*
COPY features/jq/ /tmp/devkit/jq/
RUN cd /tmp/devkit/jq && bash ./install.sh \
    && rm -rf /tmp/devkit/jq /var/lib/apt/lists/*
RUN find / -xdev -type f -perm /6000 -exec chmod a-s {} + \
    && test -z "$(find / -xdev -type f -perm /6000)"
RUN useradd --uid 1000 --user-group --create-home --home-dir /home/worker --shell /usr/sbin/nologin worker
ENV HOME=/home/worker PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
LABEL org.opencontainers.image.title="devkit-demo" \
      devkit.kit="demo" \
      devkit.apt_snapshot="20261019T000000Z" \
      devkit.feature.git="8a2f709e66f58d09" \
      devkit.feature.jq="41aca13c852b92f1" \
      devkit.commit="0123abc"
USER 1000:1000
WORKDIR /
